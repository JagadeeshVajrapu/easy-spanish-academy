generator client {
  provider = "prisma-client-js"
}

datasource db {
  // PostgreSQL for production (Neon / Supabase / Railway / local Postgres)
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BlogStatus {
  DRAFT
  PUBLISHED
}

model Blog {
  id            String     @id @default(cuid())
  title         String
  slug          String     @unique
  content       String
  excerpt       String
  featuredImage String
  category      String
  status        BlogStatus @default(DRAFT)
  author        String
  publishedAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([status, publishedAt])
  @@index([category])
}
