# Copy to .env and fill in real values.

# PostgreSQL connection string (Neon / Supabase / Railway)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Admin login
ADMIN_USERNAME="easyspanishacademy01@gmail.com"
ADMIN_PASSWORD="EasySpanish@123"

# Secret used to sign admin session cookies (min 32 characters)
AUTH_SECRET="esa-dev-auth-secret-change-in-production-32chars"

# Cloudinary — required for blog image uploads (API key must allow upload/create)
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"
# Optional: unsigned upload preset (Settings → Upload → Upload presets → Unsigned)
# CLOUDINARY_UPLOAD_PRESET="your_unsigned_preset"
